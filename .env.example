# Get your key from https://cursor.com/settings
CURSOR_API_KEY=

# Market data (Massive, formerly Finnhub/Polygon) — https://massive.com/docs/rest/quickstart
MASSIVE_API_KEY=
# MASSIVE_API_BASE_URL=https://api.massive.com
# MASSIVE_RATE_LIMIT_PER_MINUTE=5
# MASSIVE_RETRY_WAIT_SECONDS=65
# MASSIVE_USE_SMA_ENDPOINT=true

# Dashboard (overridden by config/app.yaml after setup)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

# OAuth callback for Robinhood MCP
OAUTH_CALLBACK_PORT=9876

# Set to false if you see SSL certificate errors on Windows (Robinhood MCP)
SSL_VERIFY=true

# Sleep prevention is automatic on Windows while the bot process runs (no env var).
# System sleep is inhibited; monitors and the screensaver may still turn off.
